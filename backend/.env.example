# --- LLM (Llama) ---
# Waypoint talks to any Llama endpoint that speaks the OpenAI chat-completions
# shape. Easiest local setup: install Ollama (https://ollama.com), then:
#   ollama pull llama3.1
#   ollama serve
LLAMA_BASE_URL=http://localhost:11434/v1
LLAMA_MODEL=llama3.1
LLAMA_API_KEY=ollama
# If you'd rather point at a hosted Llama endpoint (Groq, Together, Fireworks,
# your own vLLM box, etc.), just swap the three values above — the client
# code doesn't change.

# --- Supabase (context store) ---
# Optional for local dev: leave both blank and Waypoint falls back to the
# bundled page docs in backend/page_docs_fallback.py so you can run the demo
# with zero external services. Fill these in once you've run supabase.sql.
SUPABASE_URL=
SUPABASE_KEY=

# --- Server ---
ALLOWED_ORIGIN=http://localhost:5173
